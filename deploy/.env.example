# ============================================================
# deploy/.env  -  Variables del despliegue en produccion (copie a .env y rellene).
# Lo lee docker-compose (interpolacion) y la API (env_file).
# Genere secretos con:  openssl rand -hex 32
# ============================================================

# ---- Entorno de la API ----
NODE_ENV=production
PORT=3000
LOG_LEVEL=info

# ---- Conexion a SQL Server (servicio interno 'sqlserver' de compose) ----
DB_SERVER=sqlserver
DB_PORT=1433
DB_NAME=ShopCart
DB_USER=shopcart_app
# Clave de la aplicacion (login shopcart_app). instalar-bd.sh la fija con ALTER LOGIN
# (parametro AppPassword de aplicar.sh), reemplazando la clave de desarrollo de 003.
DB_PASSWORD=cambiar_esta_clave_de_app
DB_ENCRYPT=true
# El contenedor de SQL Server usa un certificado autofirmado; por eso se confia en el
# certificado del servidor en la red interna (no hay CA). El trafico publico va por
# HTTPS en Caddy, no contra SQL Server directamente.
DB_TRUST_SERVER_CERT=true
DB_REQUEST_TIMEOUT_MS=30000

# ---- CORS: el front servido bajo el dominio ----
CORS_ORIGIN=https://jeanrodas.lat

# ---- JWT (genere cada uno con: openssl rand -hex 32) ----
JWT_ACCESS_SECRET=generar_con_openssl_rand_hex_32
JWT_REFRESH_SECRET=generar_con_openssl_rand_hex_32
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ---- Job de reservas ----
RESERVA_JOB_SEGUNDOS=60

# ---- Reportes ----
REPORTES_CACHE_TTL_SEGUNDOS=60

# ---- Rate limiting (valores por defecto para produccion) ----
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_VENTANA_MIN=15
RATE_LIMIT_CHECKOUT_MAX=20
RATE_LIMIT_CUPON_MAX=10

# ---- Un salto de proxy de confianza: Caddy esta delante de la API ----
TRUST_PROXY=1

# ---- Pago: en produccion el pago simulado DEBE quedar en false (si no, la app no arranca) ----
PAGO_SIMULADO=false

# ============================================================
# Variables que solo usan docker-compose / instalar-bd.sh (no las lee la API)
# ============================================================
# Clave del usuario 'sa' de SQL Server (fuerte; politica de SQL: mayus/minus/numero/simbolo).
MSSQL_SA_PASSWORD=cambiar_esta_clave_sa_Fuerte1!
# Correo para los avisos de Let's Encrypt (Caddy ACME).
CADDY_EMAIL=admin@jeanrodas.lat
# Dominio con DNS apuntando al VPS.
DOMINIO=jeanrodas.lat
