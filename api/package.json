{
  "name": "shopcart-api",
  "version": "1.0.0",
  "description": "ShopCart e-commerce API backend",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "overrides": {
    "@azure/msal-node": "^7.1.2",
    "minimatch": "^11.0.3",
    "uuid": "^11.1.1"
  },
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\"",
    "test:concurrencia": "node tests/concurrencia.mjs",
    "test:rendimiento": "node tests/rendimiento.mjs"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "exceljs": "^4.4.0",
    "express": "^5.1.0",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.0.0",
    "jsonwebtoken": "^9.0.3",
    "mssql": "^11.0.1",
    "pino": "^9.6.0",
    "pino-http": "^10.4.0",
    "swagger-ui-express": "^5.0.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mssql": "^9.1.7",
    "@types/node": "^24.19.2",
    "@types/swagger-ui-express": "^4.1.7",
    "eslint": "^9.17.0",
    "eslint-config-prettier": "^9.1.0",
    "pino-pretty": "^13.0.0",
    "prettier": "^3.4.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.19.1"
  }
}
