# Entorno de la aplicacion
NODE_ENV=development
PORT=3000

# Logs: nivel de pino (trace|debug|info|warn|error|fatal|silent). Default info.
# Con NODE_ENV=development la salida es legible (pino-pretty); en otros entornos es JSON.
LOG_LEVEL=info

# Conexion a SQL Server
DB_SERVER=localhost
DB_PORT=1433
DB_NAME=ShopCart
DB_USER=shopcart_app
DB_PASSWORD=ShopCart_Dev_2026!
DB_ENCRYPT=true
DB_TRUST_SERVER_CERT=true
# Timeout de cada request a SQL Server, en milisegundos
DB_REQUEST_TIMEOUT_MS=30000

# CORS: lista de origenes separada por comas
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# JWT (los secretos deben tener al menos 32 caracteres)
JWT_ACCESS_SECRET=reemplazar_por_secreto_access_de_32+_chars
JWT_REFRESH_SECRET=reemplazar_por_secreto_refresh_de_32+_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Config tecnica. La config de NEGOCIO (minutos de reserva, horas de abandono de
# carrito, porcentaje de IVA, etc.) NO vive aqui: esta en la tabla dbo.Parametro.
# Intervalo del job que libera reservas vencidas, en segundos.
RESERVA_JOB_SEGUNDOS=60

# Proxy: numero de saltos de proxy de confianza para derivar la IP de
# X-Forwarded-For (Express 'trust proxy'). 0 = sin proxy (usa la IP del socket).
# Detras de 1 proxy/balanceador propio, poner 1; etc. Afecta req.ip y el rate limiting.
TRUST_PROXY=0

# Rate limiting de autenticacion
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_AUTH_VENTANA_MIN=15

# Rate limiting del checkout: maximo de operaciones por usuario por minuto
RATE_LIMIT_CHECKOUT_MAX=20

# Rate limiting de aplicacion de cupones: maximo por identidad (usuario/token) por minuto
RATE_LIMIT_CUPON_MAX=10

# Cache de reportes (RF-08): segundos de vigencia por entrada. 0 desactiva el cache.
# Para medir el rendimiento puro de los SPs correr test:rendimiento con este valor en 0.
REPORTES_CACHE_TTL_SEGUNDOS=60

# Pago simulado (solo desarrollo/demo): el backend decide el resultado del pago.
# En produccion debe quedar en false o la app no arranca.
PAGO_SIMULADO=true
